{
  "schemaVersion": "0.1.1",
  "kind": "graph",
  "title": "Card capture moves off the checkout write path",
  "summary": "Checkout used to call Stripe before it wrote the order, so a shopper waited on the card network and a slow capture lost the order with it. The order is now written first and the capture is enqueued; a worker drains the queue and Stripe calls back over a webhook to mark the order paid. A cache drops replayed webhooks so nobody is charged twice.",
  "lenses": [
    "architecture",
    "data-flow"
  ],
